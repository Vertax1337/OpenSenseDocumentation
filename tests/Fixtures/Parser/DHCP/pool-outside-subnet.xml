<?xml version="1.0" encoding="utf-8"?>
<opnsense>
  <system>
    <hostname>fw-dhcp-fixture</hostname>
    <domain>example.invalid</domain>
  </system>
  <interfaces>
    <lan>
      <enable>1</enable>
      <if>igc0</if>
      <descr>LAN</descr>
      <ipaddr>192.0.2.1</ipaddr>
      <subnet>24</subnet>
    </lan>
  </interfaces>
  <OPNsense>
    <Kea>
      <dhcp4 version="1.0.4" description="Kea DHCPv4 configuration">
        <general>
          <enabled>1</enabled>
          <manual_config>0</manual_config>
