          <valid_lifetime>4000</valid_lifetime>
          <fwrules>1</fwrules>
          <dhcp_socket_type>raw</dhcp_socket_type>
        </general>
        <subnets>
          <subnet4 uuid="11111111-1111-4111-8111-111111111111">
            <subnet>192.0.2.0/24</subnet>
            <option_data_autocollect>0</option_data_autocollect>
            <option_data>
              <domain_name_servers>192.0.2.1</domain_name_servers>
              <domain_search>example.invalid</domain_search>
              <routers>192.0.2.1</routers>
              <domain_name>example.invalid</domain_name>
              <ntp_servers>192.0.2.1</ntp_servers>
            </option_data>
            <match-client-id>1</match-client-id>
            <pools>198.51.100.10-198.51.100.20</pools>
          </subnet4>
        </subnets>
        <reservations>

        </reservations>
        <ha_peers />
      </dhcp4>
    </Kea>
  </OPNsense>
</opnsense>
