<?xml version="1.0" encoding="utf-8"?>
<opnsense>
  <system>
    <hostname>fw-dhcp-fixture</hostname>
    <domain>example.invalid</domain>
  </system>
  <interfaces>
    <lan>
      <enable>1</enable>
      <if>igc0</if>
      <descr>LAN</descr>
      <ipaddr>192.0.2.1</ipaddr>
      <subnet>24</subnet>
    </lan>
  </interfaces>
  <dhcpd>
    <lan>
      <enable>1</enable>
      <range>
        <from>192.0.2.10</from>
        <to>192.0.2.245</to>
      </range>
    </lan>
  </dhcpd>
  <OPNsense>
    <Kea>
      <dhcp4 version="1.0.4" description="Kea DHCPv4 configuration">
        <general>
          <enabled>1</enabled>
          <manual_config>0</manual_config>
          <interfaces>lan</interfaces>
          <valid_lifetime>4000</valid_lifetime>
          <fwrules>1</fwrules>
          <dhcp_socket_type>raw</dhcp_socket_type>
        </general>
        <subnets>
          <subnet4 uuid="11111111-1111-4111-8111-111111111111">
            <subnet>192.0.2.0/24</subnet>
            <option_data>
              <routers>192.0.2.1</routers>
            </option_data>
            <pools>192.0.2.50-192.0.2.199</pools>
          </subnet4>
        </subnets>
        <reservations />
        <ha_peers />
      </dhcp4>
    </Kea>
  </OPNsense>
</opnsense>
