{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/opensensedocumentation/schemas/sanitization-report.schema.json",
  "title": "OpenSenseDocumentation Sanitization Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","sanitizerVersion","generatedUtc","status","source","output","redactionSummary","redactions","residualFindings","notes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sanitizerVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["Clean","RequiresReview"] },
    "source": { "$ref": "#/$defs/fileInfo" },
    "output": { "$ref": "#/$defs/fileInfo" },
    "redactionSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["elementValues","attributeValues","embeddedPatterns","removedAuditNodes","total"],
      "properties": {
        "elementValues": { "type": "integer", "minimum": 0 },
        "attributeValues": { "type": "integer", "minimum": 0 },
        "embeddedPatterns": { "type": "integer", "minimum": 0 },
        "removedAuditNodes": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "redactions": { "type": "array", "items": { "$ref": "#/$defs/redaction" } },
    "residualFindings": { "type": "array", "items": { "$ref": "#/$defs/residual" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "fileInfo": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName","sizeBytes","sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["kind","path","rule"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "residual": {
      "type": "object", "additionalProperties": false,
      "required": ["severity","path","reason"],
      "properties": {
        "severity": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
